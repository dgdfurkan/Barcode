{
  "manifest_version": 3,
  "name": "Jet Barkod Asistan",
  "version": "0.10.1",
  "description": "Jet Barkod araçlarının tamamı tek eklentide. Getir panellerinde kopyalama, sayım ve arama işlerini tek yerden yürütür.",
  "icons": {
    "16": "varliklar/ikon16.png",
    "32": "varliklar/ikon32.png",
    "48": "varliklar/ikon48.png",
    "128": "varliklar/ikon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://warehouse.getir.com/*",
    "https://franchise.getir.com/*",
    "https://warehouse-panel-api-gateway.getirapi.com/*",
    "https://franchise-api-gateway.getirapi.com/*",
    "https://*.getirapi.com/*",
    "https://jetbarkod.com.tr/*",
    "https://www.jetbarkod.com.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "arka-plan.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://warehouse.getir.com/*",
        "https://franchise.getir.com/*"
      ],
      "js": [
        "sayfa-koprusu.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://jetbarkod.com.tr/*",
        "https://www.jetbarkod.com.tr/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-yardimci.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://warehouse.getir.com/*"
      ],
      "js": [
        "ortak/cekirdek.js",
        "moduller/toplu-kopyalama.js",
        "moduller/sayim-kopyalama.js",
        "moduller/hizli-bul.js",
        "moduller/firin-pisirme.js",
        "moduller/raf-etiketi.js",
        "yukleyici.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://franchise.getir.com/*"
      ],
      "js": [
        "ortak/cekirdek.js",
        "moduller/stok-barkodlari.js",
        "moduller/dusuk-stok.js",
        "moduller/sayim-hazirligi.js",
        "moduller/urun-cekici.js",
        "yukleyici.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jetbarkod.com.tr/*",
        "https://www.jetbarkod.com.tr/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-koprusu.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Jet Barkod Asistan",
    "default_popup": "arayuz/kapi.html"
  },
  "externally_connectable": {
    "matches": [
      "https://jetbarkod.com.tr/*",
      "https://www.jetbarkod.com.tr/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://franchise.getir.com/*"
    ]
  }
}