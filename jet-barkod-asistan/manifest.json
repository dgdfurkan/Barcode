{
  "manifest_version": 3,
  "name": "Jet Barkod Asistan",
  "version": "0.1.0",
  "description": "Jet Barkod araçlarının tamamı tek eklentide. Getir panellerinde kopyalama, sayım ve arama işlerini tek yerden yürütür.",
  "icons": {
    "16": "varliklar/ikon128.png",
    "48": "varliklar/ikon128.png",
    "128": "varliklar/ikon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://warehouse.getir.com/*",
    "https://jetbarkod.com.tr/*",
    "https://www.jetbarkod.com.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "arka-plan.js"
  },
  "content_scripts": [
    {
      "matches": ["https://warehouse.getir.com/*"],
      "js": [
        "ortak/cekirdek.js",
        "ortak/panel.js",
        "moduller/toplu-kopyalama.js",
        "moduller/sayim-kopyalama.js",
        "yukleyici.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jetbarkod.com.tr/*",
        "https://www.jetbarkod.com.tr/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["site-koprusu.js"],
      "run_at": "document_end"
    }
  ]
}
