{
  "manifest_version": 3,
  "name": "Getir Stok Barkodları",
  "version": "2.0.0",
  "description": "Franchise stok listesindeki ürün avatar görsellerinin CDN URL’lerini DOM’dan toplayıp virgülle kopyalar.",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Sayfadaki “Görsel URL'leri kopyala” butonunu kullan"
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://franchise.getir.com/*"],
  "content_scripts": [
    {
      "matches": ["https://franchise.getir.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
