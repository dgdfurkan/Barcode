{
  "manifest_version": 3,
  "name": "Getir Stok Barkodları",
  "version": "1.2.0",
  "description": "POST /stocks API ile barkodları çeker (token sayfadan); virgülle listeler.",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Sayfada “Barkodları kopyala” — önce stok listesi yüklensin"
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://franchise.getir.com/*",
    "https://franchise-api-gateway.getirapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://franchise.getir.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
