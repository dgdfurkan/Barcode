{
  "manifest_version": 3,
  "name": "Getir Warehouse Shelf Label Fetcher",
  "version": "1.1.0",
  "description": "Warehouse.getir.com'dan raf etiketlerini çekme extension'ı (Admin panel için)",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://warehouse.getir.com/*",
    "https://warehouse-panel-api-gateway.getirapi.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://warehouse.getir.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
      "js": ["admin_panel_inject.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*/*"
    ]
  }
}

